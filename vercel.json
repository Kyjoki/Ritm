{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "chatgpt/ios-notifications-widgets-live-activities": false,
      "codex/ritm-native-ios": false,
      "claude/ritm-native-ios-parity": false,
      "claude/ritm-health-live-activity": false,
      "claude/ritm-workouts-sync": false,
      "claude/ritm-security": false,
      "claude/ritm-session-keep": false,
      "claude/ritm-workouts-redesign": false,
      "claude/ritm-card-operations": false,
      "claude/ritm-workout-live-edit": false,
      "claude/ritm-habits-native": false,
      "claude/ritm-card-operations-server": false,
      "claude/ritm-web-habits": false,
      "claude/ritm-web-workouts": false,
      "claude/ritm-web-finance": false,
      "claude/ritm-web-motion": false,
      "claude/ritm-web-finance-fixes": false,
      "claude/ritm-web-sidebar-contrast": false,
      "claude/ritm-ios-settings": false,
      "claude/ritm-ios-calendar": false
    }
  },
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "build/client",
  "functions": { "api/index.ts": { "maxDuration": 180 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
