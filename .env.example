# Server-only configuration. Copy to .env; never use VITE_ for secrets.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
SEED_DEMO=true

# One owner, no public registration. Login is case-insensitive.
APP_LOGIN=maksim
# Optional locally; mandatory for NODE_ENV=production or non-loopback HOST.
# Recommended: 20+ characters (a passphrase). Shorter passwords of 12+ still work.
# APP_PASSWORD=use-a-long-unique-password-here
# Shared signed session key, at least 32 random bytes; mandatory in production.
# APP_SESSION_SECRET=

# PostgreSQL is mandatory on Vercel; local development can keep SQLite.
# DATABASE_URL=
# AES-GCM key: exactly 32 random bytes encoded as base64 (or 64 hex chars).
# Required for saved OpenAI/OAuth secrets in shared PostgreSQL.
# SECRET_ENCRYPTION_KEY=

# Set for network access behind HTTPS. Do not include a trailing path.
# APP_ORIGIN=https://ritm.example.com

# Prefer setting your own key in the UI on a trusted machine, or in this file.
# No live OpenAI requests are made until a user sends a chat message.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Google Calendar primary calendar: configure credentials in Settings → Connections.
# APP_ORIGIN is required for the UI callback (locally: http://127.0.0.1:5173).
# Optional server-managed credentials below override the saved UI configuration.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://ritm.example.com/api/integrations/google/callback

# Telegram bot: create a bot in @BotFather, then paste its token into
# Settings → Connections → Telegram. The token is encrypted server-side.
# APP_ORIGIN must be the public HTTPS address for Telegram webhooks.
