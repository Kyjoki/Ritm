{
  "name": "ritm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview:visual": "node scripts/preview-visual.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx migrations/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.92",
    "@fontsource/inter": "5.3.0",
    "ai": "7.0.138",
    "express": "5.3.0",
    "google-auth-library": "11.3.0",
    "jose": "6.2.12",
    "lucide-react": "1.55.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pg-mem": "3.0.14",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
